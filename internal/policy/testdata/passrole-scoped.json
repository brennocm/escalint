{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPassRole",
      "Effect": "Allow",
      "Action": ["iam:PassRole", "iam:GetRole"],
      "Resource": "arn:aws:iam::111111111111:role/app-*",
      "Condition": { "StringEquals": { "iam:PassedToService": ["lambda.amazonaws.com", "ec2.amazonaws.com"] } }
    },
    { "Effect": "Allow", "Action": "lambda:CreateFunction", "NotResource": "arn:aws:lambda:*:111111111111:function:prod-*" }
  ]
}
